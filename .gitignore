# --- Training checkpoints -------------------------------------------------
# Per-episode snapshots are regenerable and run to ~370 MB, so they stay local.
# The final trained models are committed so evaluation works after a clone.
outputs/checkpoints/**/*.pth
!outputs/checkpoints/**/*_final.pth
!outputs/checkpoints/security/lstm_predictor.pth
!outputs/checkpoints/supervisor/test_*.pth
# these two snapshots are loaded by name from the phase 0/1 scripts
!outputs/checkpoints/single/ddqn_episode_400.pth
!outputs/checkpoints/single/ddqn_episode_900.pth

